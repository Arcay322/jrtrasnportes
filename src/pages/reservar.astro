---
import Layout from '../components/Layout.astro';
import BookingEngine from '../components/BookingEngine.tsx';
import '../styles/global.css';

const schemas = [
  {
    "@context": 'https://schema.org',
    "@type": 'WebPage',
    name: 'Reservar Pasajes y Tours - JR Transportes',
    description: 'Reserva tus pasajes de minivan y tours turísticos a Cangallo, Pampa Cangallo y Huancasancos en tiempo real.'
  }
];
---

<Layout
  title="Reservar Pasajes y Tours | JR Transportes"
  description="Reserva tus pasajes de minivan y tours en tiempo real a Cangallo, Pampa Cangallo y Huancasancos con confirmación inmediata."
  keywords="reservar pasajes, pasajes ayacucho, pasajes cangallo, pasajes huancasancos, reserva tours, JR transportes, boletos de minivan"
  ogTitle="Reservar Pasajes y Tours | JR Transportes"
  ogDescription="Reserva tus pasajes de minivan y tours en tiempo real a Cangallo, Pampa Cangallo y Huancasancos."
  ogType="website"
  schema={schemas}
  activePage="reservar"
  ctaText="Consultar por WhatsApp"
  ctaHref="https://wa.me/51928413201"
  mainClass="relative z-0 overflow-x-clip bg-pampa-50/30 py-12"
>
  <div class="mx-auto w-full max-w-6xl px-5 py-8">
    <div class="mb-10 text-center">
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-pampa-500">
        Viaja Seguro y Rápido
      </p>
      <h1 class="font-headline text-4xl text-pampa-900 sm:text-5xl">
        Reserva tus Pasajes y Tours
      </h1>
      <p class="mt-3 text-sm text-pampa-700/70">
        Elige tu destino, selecciona tus asientos y paga de forma segura en línea con MercadoPago.
      </p>
      <div class="andean-divider mx-auto mt-6 max-w-[120px]"></div>
    </div>

    {/* Renderizar el componente interactivo de React */}
    <BookingEngine client:load />
  </div>
</Layout>
