---
import Layout from '../components/Layout.astro';
import AdminDashboard from '../components/AdminDashboard.tsx';
import { auth, db } from '../lib/firebaseAdmin';
import '../styles/global.css';

// 1. Validar sesión del lado del servidor
const sessionCookie = Astro.cookies.get('__session')?.value;

if (!sessionCookie) {
  return Astro.redirect('/login?redirect=/admin');
}

let decodedClaims;
try {
  decodedClaims = await auth.verifySessionCookie(sessionCookie, true);
} catch (error) {
  console.warn('Sesión no válida o expirada para admin. Redirigiendo a Login.', error);
  Astro.cookies.delete('__session', { path: '/' });
  return Astro.redirect('/login?redirect=/admin');
}

// 2. Consultar rol en Firestore
let role = 'client';
try {
  const userDoc = await db.collection('users').doc(decodedClaims.uid).get();
  if (userDoc.exists) {
    role = userDoc.data()?.role || 'client';
  } else {
    // Si la DB está vacía o es un usuario simulado
    if (decodedClaims.email === 'admin@viajaayacucho.com') {
      role = 'admin';
    }
  }
} catch (dbError) {
  console.warn('⚠️ Error al consultar rol en Firestore. Usando fallback de email.', dbError);
  if (decodedClaims.email === 'admin@viajaayacucho.com') {
    role = 'admin';
  }
}

if (role !== 'admin' && role !== 'operator') {
  // Redirigir a mis reservas si no tiene rol administrativo
  return Astro.redirect('/mis-reservas');
}

const schemas = [
  {
    "@context": 'https://schema.org',
    "@type": 'WebPage',
    name: 'Panel Administrativo - JR Transportes',
    description: 'Gestión interna de flota, rutas y reservaciones para el equipo de operadores de JR Transportes.'
  }
];
---

<Layout
  title="Panel de Control Interno | JR Transportes"
  description="Gestión interna de flota, rutas y reservaciones para los operadores de JR Transportes en Ayacucho."
  keywords="admin, administrador, panel, control flota, operadores, JR transportes"
  ogTitle="Panel de Control Interno | JR Transportes"
  ogDescription="Gestión de flota y monitoreo de ventas para el equipo de JR Transportes."
  ogType="website"
  schema={schemas}
  activePage="admin"
  ctaText="Ir a Reservas"
  ctaHref="/reservar"
  mainClass="relative z-0 overflow-x-clip bg-pampa-50/20 py-12"
>
  <div class="mx-auto w-full max-w-6xl px-5 py-8">
    <div class="mb-10 text-center">
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.15em] text-pampa-500 font-data">
        Área Privada de Operaciones
      </p>
      <h1 class="font-headline text-4xl text-pampa-900 sm:text-5xl">
        ViajaAyacucho Back-office
      </h1>
      <p class="mt-3 text-sm text-pampa-700/70">
        Monitoreo cuantitativo de ventas, estado operacional de la flota y conciliación de reservas.
      </p>
      <div class="andean-divider mx-auto mt-6 max-w-[120px]"></div>
    </div>

    {/* Renderizar el dashboard interactivo de React */}
    <AdminDashboard client:load />
  </div>
</Layout>
